pipeline {

    agent any

    environment {
        REGISTRY = 'localhost:5000'
        XLR_URL = 'http://xlr:5516'
        IMAGE_NAME = 'hello-xld-xlr'
    }

    options {
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                dir('application') {
                    sh 'mvn test'
                }
            }
        }

        stage('Get Version') {
            steps {
                script {
                    env.APP_VERSION = sh(
                        script: '''
                            cd application
                            mvn help:evaluate \
                            -Dexpression=project.version \
                            -q \
                            -DforceStdout
                        ''',
                        returnStdout: true
                    ).trim()

                    env.IMAGE = "${REGISTRY}/${IMAGE_NAME}:${APP_VERSION}"
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${IMAGE} ./application'
            }
        }

        stage('Docker Push') {
            steps {
                sh 'docker push ${IMAGE}'
            }
        }

        stage('Release on XLR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'xlr-credentials',
                        usernameVariable: 'XLR_USER',
                        passwordVariable: 'XLR_PASSWORD'
                    )
                ]) {
                    script {
                        def payload = [
                            releaseTitle: "Hello-XLD-XLR Release",
                            releaseVariables: [
                                app_version: env.APP_VERSION
                            ]
                        ]

                        writeFile(
                            file: 'xlr-payload.json',
                            text: groovy.json.JsonOutput.toJson(payload)
                        )

                        withEnv([
                            "XLR_TEMPLATE_ID=Release034f26f5d3c149f1876c4966d63467ff"
                        ]) {
                            sh '''
                                set +x

                                curl --fail --silent --show-error \
                                --user "$XLR_USER:$XLR_PASSWORD" \
                                --header "Content-Type: application/json" \
                                --request POST \
                                --data-binary @xlr-payload.json \
                                "$XLR_URL/api/v1/templates/$XLR_TEMPLATE_ID/start"
                            '''
                        }
                    }
                }
            }
        }

    }

    post {

        success {
            echo "Build successful: ${IMAGE}"
        }

        failure {
            echo "Build failed"
        }

    }

}